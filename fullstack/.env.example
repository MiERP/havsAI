# havsAI fullstack — model provider configuration
# Copy this file to `.env` in the same folder: fullstack/.env

# Admin panel (/admin). Seeded only when admin_accounts is empty.
# Default is admin/admin; change it immediately after the first login.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin

# Key used to encrypt AI provider API keys. If unset, fullstack/data/settings.key
# is generated with mode 0600. Back this key up with the database.
# SETTINGS_KEY=paste-a-long-random-secret-here

# Option A (default): use the Command Code account already logged in on this PC.
# It reads ~/.commandcode/auth.json automatically; no key needed here.
# AI_PROVIDER=commandcode
# COMMANDCODE_MODEL=deepseek/deepseek-v4.1-flash
# COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1

# Option B: call DeepSeek directly with your own API key.
# Uncomment the lines below and paste your key.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-paste-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Option C: offline mock, no network.
# AI_PROVIDER=mock

# Vision — chỉ dùng model DeepSeek.
# Bắt buộc reasoning_effort=off: nếu không, model trả content rỗng (chỉ reasoning).
# VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp
# VISION_FALLBACK_MODEL=deepseek/deepseek-v4-flash-vision-exp
# VISION_REASONING_EFFORT=off
# VISION_BASE_URL=https://api.commandcode.ai/provider/v1
# VISION_API_KEY=...

# PDF: số trang tối đa khi upload, số trang OCR bằng vision khi PDF scan.
# PDF_MAX_PAGES=50
# PDF_VISION_PAGES=3
# PDF_VISION_CONCURRENCY=2

# Auth: chỉ bật OTP cố định 123456 khi chạy máy local. Không bao giờ bật trên
# server công khai; giá trị này bị bỏ qua khi NODE_ENV=production.
# ALLOW_DEV_OTP=true

# Cookie phiên: mặc định luôn có Secure trừ khi host là localhost/127.0.0.1.
# Đặt false chỉ khi chạy HTTP trên một host nội bộ khác.
# COOKIE_SECURE=false

# Email OTP cho production. Không cấu hình mailer thì request-code trả 503.
# Cách 1 — Resend HTTP API (không cần thêm dependency):
# RESEND_API_KEY=re_...
# OTP_FROM_EMAIL=havsAI <no-reply@your-domain>
# Cách 2 — SMTP (cần chạy: npm install nodemailer):
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# OTP_FROM_EMAIL=havsAI <no-reply@your-domain>

# Android App Links: SHA-256 chứng chỉ ký app, dạng AA:BB:... (nhiều giá trị cách nhau dấu phẩy).
# Lấy bằng: keytool -list -v -keystore <keystore> -alias <alias>
# Không cấu hình thì /.well-known/assetlinks.json trả 503.
# ANDROID_SHA256_FINGERPRINTS=AA:BB:CC:...
# ANDROID_PACKAGE_NAME=com.havs.ai
